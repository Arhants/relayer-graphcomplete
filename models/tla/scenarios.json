      "id": "provider-connect-completes",
      "module": "ProviderSettings",
      "preset": "providers",
      "init": "defaultFamily = \"custom\"",
      "promises": [
        "PendingAttemptIsOwned",
        "PendingReconnectIsForActiveProvider",
        "LeasedRuntimeStaysOpen"
      ],
      "summary": "A new managed connection signs in, waits one poll, and connects.",
      "steps": [
        [
          "ConnStart"
        ],
        [
          "ConnS1"
        ],
        [
          "ConnS2"
        ],
        [
          "ConnLogin"
        ],
        [
          "Handoff",
          "N",
          "ok"
        ],
        [
          "IpcReturn",
          "N"
        ],
        [
          "CompleteStart",
          "N"
        ],
        [
          "CompleteFinish",
          "N",
          "disconnected"
        ],
        [
          "CompleteStart",
          "N"
        ],
        [
          "CompleteFinish",
          "N",
          "connected"
        ]
      ]
    },
