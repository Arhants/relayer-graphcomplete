          "P"
        ],
        [
          "CompleteFinish",
          "P",
          "connected"
        ],
        [
          "ExecAdmit",
          "e1"
        ],
        [
          "ExecAcquire",
          "e1"
        ],
        [
          "ExecRelease",
          "e1"
        ]
      ]
    },
