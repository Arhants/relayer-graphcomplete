        "MaxFlips": "0",
        "InitAdapters": "{\"stub\"}",
        "Ops": "{\"logout\"}",
        "InitDefFams": "{\"mP\"}"
      },
      "fair": true,
      "properties": [
        "LogoutReturns"
      ],
      "expect": {
        "violated": "LogoutReturns"
      },
      "finding": "Logout waits inside the provider queue for its own refresh, which is queued behind an explicit stub recovery that waits for the provider queue: neither returns."
    },
