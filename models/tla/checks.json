{
  "version": 1,
  "tlaTools": {
    "version": "1.8.0",
    "url": "https://github.com/tlaplus/tlaplus/releases/download/v1.8.0/tla2tools.jar",
    "sha256": "7c6a30fcfca96c6d7476e705a545837afbf66446c3fcb34bf39b838cd50ee0c0"
  },
  "presets": {
    "providers": {
      "MaxTransientChecks": "3",
      "Execs": "{\"e1\"}",
      "RuntimeIds": "{1, 2, 3}"
    },
    "completion-today": {
      "Launchers": "{1, 2}",
      "MaxRev": "3",
      "ValidFailReasons": "{\"provider_exited_without_return\", \"application_restart\", \"execution\", \"provider_start_failed\", \"provider_attachment_persist_failed\", \"graph_observation_failed\", \"model_unavailable\"}",
      "ObserveTimesOut": "FALSE",
      "CleanExitIsChecked": "TRUE",
      "ActivationFailureSettlesGraph": "FALSE",
      "TerminalReadSettlesCleanup": "TRUE",
      "ChildAdmission": "TRUE"
    },
    "completion-fixed": {
      "Launchers": "{1, 2}",
      "MaxRev": "3",
      "ValidFailReasons": "{\"provider_exited_without_return\", \"application_restart\", \"execution\", \"provider_start_failed\", \"provider_attachment_persist_failed\", \"graph_observation_failed\", \"model_unavailable\"}",
      "ObserveTimesOut": "FALSE",
      "CleanExitIsChecked": "TRUE",
      "ActivationFailureSettlesGraph": "TRUE",
      "TerminalReadSettlesCleanup": "TRUE",
      "ChildAdmission": "TRUE"
    },
    "leases-today": {
      "Turns": "{1}",
      "MaxRestarts": "0",
      "AdmissionTimeout": "FALSE",
      "RustCanAbandon": "FALSE",
      "PersistCanFail": "FALSE",
      "StartupQuarantine": "FALSE",
      "HarnessCanHang": "FALSE",
      "HostReleasesOnSettle": "TRUE",
      "ClaimRejectsReleasing": "TRUE",
      "AckRetriesFinalize": "TRUE",
      "QuarantineSettleWakesReconciler": "TRUE",
      "StartupCleanupCanFail": "FALSE",
      "PersistFailureEndsWait": "TRUE",
      "RestartEndsWaits": "TRUE",
      "StartupIsolatesProviders": "TRUE"
    },
    "catalog-today": {
      "MaxQ": "2",
      "MaxEvents": "2",
      "AllowPre": "TRUE",
      "AllowClose": "TRUE",
      "WithQ": "TRUE",
      "UserOps": "TRUE",
      "MaxFlips": "2",
      "InitAdapters": "{\"real\", \"stub\"}",
      "Ops": "{\"logout\", \"reconnect\", \"remove\"}",
      "InitDefFams": "{\"mP\", \"C\", \"none\"}",
      "DefaultProviderPairsFamily": "TRUE"
    }
  },
  "checks": [
    {
      "id": "provider-leased-runtime",
      "module": "ProviderSettings",
      "preset": "providers",
      "invariants": [
        "TypeOK",
        "LeasedRuntimeStaysOpen"
      ],
      "expect": {
        "violated": "LeasedRuntimeStaysOpen"
      },
      "finding": "A turn admitted while the provider looked connected leases the runtime a pending reconnect registered; cancelling that reconnect closes it under the turn."
    },
    {
      "id": "provider-remove-during-reconnect",
      "module": "ProviderSettings",
      "preset": "providers",
      "invariants": [
        "TypeOK",
        "PendingReconnectIsForActiveProvider"
      ],
      "expect": "pass",
      "finding": "Removing a provider drops its pending reconnect as it enters removal_pending (fixed; was: the reconnect outlived the removal)."
    },
    {
      "id": "provider-attempt-ownership",
      "module": "ProviderSettings",
      "preset": "providers",
      "invariants": [
        "TypeOK",
        "PendingAttemptIsOwned"
      ],
      "expect": "pass",
      "finding": "Every pending attempt keeps an owner, including when the renderer is destroyed before binding (fixed; BRW-005)."
    },
    {
      "id": "provider-close",
      "module": "ProviderSettings",
      "preset": "providers",
      "invariants": [
        "TypeOK",
        "CloseLeavesNoOpenRuntime"
      ],
      "expect": {
        "violated": "CloseLeavesNoOpenRuntime"
      },
      "finding": "close() does not drain the provider queue or refuse leases: a turn admitted before shutdown creates and registers a runtime after the maps are cleared."
    },
    {
      "id": "provider-default-family",
      "module": "ProviderSettings",
      "preset": "providers",
      "invariants": [
        "TypeOK",
        "DefaultFamilyIsLive"
      ],
      "expect": {
        "violated": "DefaultFamilyIsLive"
      },
      "finding": "Open product question: a catalog refresh reporting no eligible models tombstones the default family until a later refresh reactivates it. No PRD promise covers this."
    },
    {
      "id": "completion-safety-holds",
      "module": "CompletionCurrent",
      "preset": "completion-today",
      "invariants": [
        "TypeOK",
        "AtMostOneLaunch",
        "StopReportIsTruthful",
        "LeaseReleasedOnlyAfterSettlement",
        "AccessReleasedOnlyAfterProviderRun",
        "ProviderRunsUnderLease",
        "AttemptEndsOnlyAfterProvider"
      ],
      "properties": [
        "TerminalIsAbsorbing"
      ],
      "expect": "pass",
      "finding": "One launch per reservation; stop reports what the graph holds; terminal states are absorbing; an admitted child's provider runs under held access, which the host releases once the run ends; its attempt ends, and its lease record is released, only after it settles and its provider run ends."
    },
    {
      "id": "completion-observe-timeout",
      "module": "CompletionCurrent",
      "preset": "completion-today",
      "constants": {
        "ActivationFailureSettlesGraph": "TRUE",
        "CleanExitIsChecked": "TRUE",
        "TerminalReadSettlesCleanup": "TRUE"
      },
      "invariants": [
        "TypeOK",
        "NoExitFailureWhileRunning"
      ],
      "expect": "pass",
      "finding": "With observations that no longer time out, a child whose provider is still running is never failed for it (fixed; was: the 5 s control timeout failed running children). The re-poll itself is proved by provider_end_waits_through_observation_timeouts, not by this check."
    },
    {
      "id": "completion-activation-failure",
      "module": "CompletionCurrent",
      "preset": "completion-today",
      "constants": {
        "ObserveTimesOut": "FALSE",
        "CleanExitIsChecked": "TRUE",
        "TerminalReadSettlesCleanup": "TRUE"
      },
      "invariants": [
        "TypeOK",
        "SettledExecutionAgreesWithGraph"
      ],
      "expect": {
        "violated": "SettledExecutionAgreesWithGraph"
      },
      "finding": "A failed activation settles the execution row while the graph current stays active."
    },
    {
      "id": "completion-clean-exit",
      "module": "CompletionCurrent",
      "preset": "completion-today",
      "constants": {
        "Launchers": "{1}",
        "ObserveTimesOut": "FALSE",
        "ActivationFailureSettlesGraph": "TRUE",
        "TerminalReadSettlesCleanup": "TRUE"
      },
      "fair": true,
      "properties": [
        "LaunchedChildSettles"
      ],
      "expect": "pass",
      "finding": "A child whose provider exits cleanly without Return is failed and settles (fixed; was: it never settled, and with admission its attempt and leases were held forever)."
    },
    {
      "id": "completion-clean-exit-reverted",
      "module": "CompletionCurrent",
      "preset": "completion-today",
      "constants": {
        "Launchers": "{1}",
        "ObserveTimesOut": "FALSE",
        "ActivationFailureSettlesGraph": "TRUE",
        "TerminalReadSettlesCleanup": "TRUE",
        "CleanExitIsChecked": "FALSE"
      },
      "fair": true,
      "properties": [
        "LaunchedChildSettles"
      ],
      "expect": {
        "violated": "LaunchedChildSettles"
      },
      "finding": "Without the clean-exit check, a child whose provider exits cleanly without Return never settles."
    },
    {
      "id": "completion-start-failure-reason",
      "module": "CompletionCurrent",
      "preset": "completion-today",
      "constants": {
        "Launchers": "{1}",
        "ObserveTimesOut": "FALSE",
        "ActivationFailureSettlesGraph": "TRUE",
        "CleanExitIsChecked": "TRUE",
        "TerminalReadSettlesCleanup": "TRUE"
      },
      "fair": true,
      "properties": [
        "ClaimedChildSettles"
      ],
      "expect": "pass",
      "finding": "Start-failure cleanup fails the current with a reason the graph accepts (fixed; was: retried a rejected reason forever)."
    },
    {
      "id": "completion-start-failure-terminal",
      "module": "CompletionCurrent",
      "preset": "completion-today",
      "constants": {
        "Launchers": "{1}",
        "ObserveTimesOut": "FALSE",
        "ActivationFailureSettlesGraph": "TRUE",
        "CleanExitIsChecked": "TRUE"
      },
      "fair": true,
      "properties": [
        "ClaimedChildSettles"
      ],
      "expect": "pass",
      "finding": "Start-failure cleanup settles a current another actor already terminated, with that current's outcome (fixed; was: retried forever)."
    },
    {
      "id": "completion-child-admission-reverted",
      "module": "CompletionCurrent",
      "preset": "completion-today",
      "constants": {
        "ChildAdmission": "FALSE"
      },
      "invariants": [
        "TypeOK",
        "ProviderRunsUnderLease"
      ],
      "expect": {
        "violated": "ProviderRunsUnderLease"
      },
      "finding": "Without child admission, a selected child's provider runs with no held lease or attempt (the behavior before child admission)."
    },
    {
      "id": "completion-restart",
      "module": "CompletionCurrent",
      "preset": "completion-today",
      "invariants": [
        "TypeOK",
        "RestartNeverAborts"
      ],
      "expect": "pass",
      "finding": "Restart reconciliation does not abort on a state the product produced."
    },
    {
      "id": "completion-fixed-safety",
      "module": "CompletionCurrent",
      "preset": "completion-fixed",
      "invariants": [
        "TypeOK",
        "AtMostOneLaunch",
        "StopReportIsTruthful",
        "RestartNeverAborts",
        "NoExitFailureWhileRunning",
        "SettledExecutionAgreesWithGraph",
        "LeaseReleasedOnlyAfterSettlement",
        "AccessReleasedOnlyAfterProviderRun",
        "ProviderRunsUnderLease",
        "AttemptEndsOnlyAfterProvider"
      ],
      "properties": [
        "TerminalIsAbsorbing"
      ],
      "expect": "pass",
      "finding": "The candidate fixes restore every safety invariant."
    },
    {
      "id": "completion-fixed-liveness",
      "module": "CompletionCurrent",
      "preset": "completion-fixed",
      "constants": {
        "Launchers": "{1}"
      },
      "fair": true,
      "properties": [
        "LaunchedChildSettles",
        "ClaimedChildSettles"
      ],
      "expect": "pass",
      "finding": "With the candidate fixes, every claimed child settles and releases its lease record and provider access."
    },
    {
      "id": "leases-safety",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "constants": {
        "Turns": "{1, 2}",
        "MaxRestarts": "2",
        "AdmissionTimeout": "TRUE",
        "RustCanAbandon": "TRUE",
        "PersistCanFail": "TRUE",
        "StartupQuarantine": "TRUE",
        "HarnessCanHang": "TRUE",
        "StartupCleanupCanFail": "TRUE"
      },
      "invariants": [
        "TypeOK",
        "RuntimeOpenWhileLeased",
        "LeaseHeldWhileTurnRuns",
        "RuntimeOpenWhileTurnRuns",
        "NoTimerOnClaimedAccess",
        "StartupSucceeds"
      ],
      "properties": [
        "AccessKeptWhileTurnRuns"
      ],
      "expect": "pass",
      "finding": "With every fault on, a leased runtime stays open, no runtime closes under a running turn, a turn runs only under held access, access is never released while its turn runs, no host timer targets a running turn's access, and the app always starts."
    },
    {
      "id": "leases-ideal",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "constants": {
        "Turns": "{1, 2}",
        "MaxRestarts": "1"
      },
      "fair": true,
      "invariants": [
        "TypeOK",
        "RuntimeOpenWhileLeased",
        "LeaseHeldWhileTurnRuns",
        "RuntimeOpenWhileTurnRuns",
        "NoTimerOnClaimedAccess",
        "StartupSucceeds"
      ],
      "properties": [
        "AccessKeptWhileTurnRuns",
        "LeaseEventuallyReleased",
        "DebtEventuallyReconciled",
        "AttemptEndsAfterTurn",
        "RemovalCompletes"
      ],
      "expect": "pass",
      "finding": "With no faults, every safety invariant holds, every lease is released, every lease debt is reconciled, every attempt whose turn ended stops holding the provider, and a removal completes without a restart."
    },
    {
      "id": "leases-abandon",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "constants": {
        "RustCanAbandon": "TRUE",
        "MaxRestarts": "1"
      },
      "invariants": [
        "LeaseHeldWhileTurnRuns",
        "RuntimeOpenWhileTurnRuns"
      ],
      "properties": [
        "AccessKeptWhileTurnRuns"
      ],
      "expect": "pass",
      "finding": "Rust giving up on a running turn and then releasing its lease cancels the turn; the access is released only when the native turn ends (fixed; was: released under the live turn, so removal could close the runtime under it)."
    },
    {
      "id": "leases-abandon-reverted",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "constants": {
        "RustCanAbandon": "TRUE",
        "MaxRestarts": "1",
        "HostReleasesOnSettle": "FALSE"
      },
      "invariants": [
        "RuntimeOpenWhileTurnRuns"
      ],
      "expect": {
        "violated": "RuntimeOpenWhileTurnRuns"
      },
      "finding": "Without the host owning the release, Rust's release after it gave up frees the access under the live native turn, and removal then closes the runtime under it."
    },
    {
      "id": "leases-timer-claim",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "constants": {
        "AdmissionTimeout": "TRUE",
        "MaxRestarts": "1"
      },
      "invariants": [
        "LeaseHeldWhileTurnRuns"
      ],
      "properties": [
        "AccessKeptWhileTurnRuns"
      ],
      "expect": "pass",
      "finding": "An admission whose release was decided cannot be claimed, so a timer release never lands under a running turn (fixed; was: the 30 s admission timer's release completed after the claim)."
    },
    {
      "id": "leases-timer-claim-reverted",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "constants": {
        "AdmissionTimeout": "TRUE",
        "MaxRestarts": "1",
        "ClaimRejectsReleasing": "FALSE"
      },
      "properties": [
        "AccessKeptWhileTurnRuns"
      ],
      "expect": {
        "violated": "AccessKeptWhileTurnRuns"
      },
      "finding": "Without the claim check, a claim during an in-flight admission release runs the turn, and the release then frees its access."
    },
    {
      "id": "leases-claim-after-failed-release",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "constants": {
        "AdmissionTimeout": "TRUE",
        "MaxRestarts": "1",
        "AckRetriesFinalize": "FALSE"
      },
      "invariants": [
        "LeaseHeldWhileTurnRuns"
      ],
      "expect": "pass",
      "finding": "A failed admission release still blocks the claim, because releaseRequested is sticky (fixed; was: the claim succeeded and the turn ran with no counted lease). A2's fix is off here: a refused finalize is the only modeled way a release fails."
    },
    {
      "id": "leases-removal-finalize",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "fair": true,
      "properties": [
        "RemovalCompletes"
      ],
      "expect": "pass",
      "finding": "A removal completes without a restart even though the host releases the last lease before Rust ends the attempt: the owner's acknowledgement retries the refused finalize (fixed; A2)."
    },
    {
      "id": "leases-removal-finalize-reverted",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "constants": {
        "AckRetriesFinalize": "FALSE"
      },
      "fair": true,
      "properties": [
        "RemovalCompletes"
      ],
      "expect": {
        "violated": "RemovalCompletes"
      },
      "finding": "Without the acknowledgement retry, the finalize refused while the attempt still ran is never retried, and removal waits for a restart."
    },
    {
      "id": "leases-view-debt",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "constants": {
        "PersistCanFail": "TRUE"
      },
      "fair": true,
      "properties": [
        "DebtEventuallyReconciled"
      ],
      "expect": "pass",
      "finding": "Settling a quarantined attempt, from the thread view or an action destination, wakes the lease reconciler, so its lease debt is reconciled (fixed; D; was: debt left until restart)."
    },
    {
      "id": "leases-view-debt-reverted",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "constants": {
        "PersistCanFail": "TRUE",
        "QuarantineSettleWakesReconciler": "FALSE",
        "PersistFailureEndsWait": "FALSE"
      },
      "fair": true,
      "properties": [
        "DebtEventuallyReconciled"
      ],
      "expect": {
        "violated": "DebtEventuallyReconciled"
      },
      "finding": "Without the wake, a settled quarantined attempt's lease debt waits for a restart. C's fix is off here: it releases the lease when the native run ends, so the settle would leave no debt."
    },
    {
      "id": "leases-persist-lease",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "constants": {
        "PersistCanFail": "TRUE"
      },
      "fair": true,
      "properties": [
        "LeaseEventuallyReleased"
      ],
      "expect": "pass",
      "finding": "A turn whose terminal state cannot be persisted still releases its access, because the host releases it when the native turn ends (fixed; C lease half; was: held forever)."
    },
    {
      "id": "leases-persist-lease-reverted",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "constants": {
        "PersistCanFail": "TRUE",
        "HostReleasesOnSettle": "FALSE",
        "PersistFailureEndsWait": "FALSE"
      },
      "fair": true,
      "properties": [
        "LeaseEventuallyReleased"
      ],
      "expect": {
        "violated": "LeaseEventuallyReleased"
      },
      "finding": "Without the host owning the release, a turn whose terminal state cannot be persisted holds its lease forever. C's attempt fix is off here: it would release the lease from the product side."
    },
    {
      "id": "leases-restart-quarantine",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "constants": {
        "StartupQuarantine": "TRUE",
        "MaxRestarts": "2"
      },
      "invariants": [
        "StartupSucceeds"
      ],
      "expect": "pass",
      "finding": "A startup that finds a removal_pending provider whose quarantined attempt still runs now starts, leaving the provider removal_pending (fixed; E's startup failure)."
    },
    {
      "id": "leases-restart-quarantine-reverted",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "constants": {
        "StartupQuarantine": "TRUE",
        "MaxRestarts": "2",
        "AckRetriesFinalize": "FALSE",
        "RestartEndsWaits": "FALSE"
      },
      "invariants": [
        "StartupSucceeds"
      ],
      "expect": {
        "violated": "StartupSucceeds"
      },
      "finding": "Without it, the refused finalize in reconcileStartup fails every startup. E's removal fix is off here: it stops the quarantined attempt from counting, so the finalize would not be refused."
    },
    {
      "id": "leases-restart-persist",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "constants": {
        "PersistCanFail": "TRUE",
        "MaxRestarts": "1"
      },
      "invariants": [
        "StartupSucceeds"
      ],
      "expect": "pass",
      "finding": "An attempt left running by a failed persist under a removal no longer fails startup (fixed; E via C)."
    },
    {
      "id": "leases-restart-removal",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "constants": {
        "StartupQuarantine": "TRUE",
        "MaxRestarts": "1"
      },
      "fair": true,
      "properties": [
        "RemovalCompletes"
      ],
      "expect": "pass",
      "finding": "A removal that waited on a turn finishes at the next start even when startup quarantines that turn's submitted input: its attempt ran in the process that exited, so startup records its native-run end and the drain no longer counts it (fixed; E removal half)."
    },
    {
      "id": "leases-restart-removal-reverted",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "constants": {
        "StartupQuarantine": "TRUE",
        "MaxRestarts": "1",
        "RestartEndsWaits": "FALSE"
      },
      "fair": true,
      "properties": [
        "RemovalCompletes"
      ],
      "expect": {
        "violated": "RemovalCompletes"
      },
      "finding": "Without it, the quarantined attempt still counts as running after the restart, and nothing retries the finalize once the thread view settles it: the reconciler's release finds no host entry to acknowledge."
    },
    {
      "id": "leases-persist-attempt",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "constants": {
        "PersistCanFail": "TRUE"
      },
      "fair": true,
      "properties": [
        "AttemptEndsAfterTurn"
      ],
      "expect": "pass",
      "finding": "A turn whose terminal state cannot be persisted stops holding the provider once its native run ends: its attempt stays undecided for reconciliation, its lease is released, and the drain no longer counts it (fixed; C attempt half)."
    },
    {
      "id": "leases-persist-attempt-reverted",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "constants": {
        "PersistCanFail": "TRUE",
        "PersistFailureEndsWait": "FALSE"
      },
      "fair": true,
      "properties": [
        "AttemptEndsAfterTurn"
      ],
      "expect": {
        "violated": "AttemptEndsAfterTurn"
      },
      "finding": "Without it, a turn whose terminal state cannot be persisted leaves its attempt running, which blocks the provider tombstone until a restart."
    },
    {
      "id": "leases-persist-removal",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "constants": {
        "PersistCanFail": "TRUE"
      },
      "fair": true,
      "properties": [
        "RemovalCompletes",
        "DebtEventuallyReconciled"
      ],
      "expect": "pass",
      "finding": "A removal waiting on a turn whose terminal state cannot be persisted finishes without a restart, and the ended attempt's lease is reconciled once (fixed; C)."
    },
    {
      "id": "leases-persist-removal-reverted",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "constants": {
        "PersistCanFail": "TRUE",
        "PersistFailureEndsWait": "FALSE"
      },
      "fair": true,
      "properties": [
        "RemovalCompletes"
      ],
      "expect": {
        "violated": "RemovalCompletes"
      },
      "finding": "Without it, that removal waits for a restart."
    },
    {
      "id": "leases-startup-isolation",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "constants": {
        "StartupCleanupCanFail": "TRUE",
        "MaxRestarts": "2"
      },
      "invariants": [
        "StartupSucceeds"
      ],
      "expect": "pass",
      "finding": "A pending removal whose finalize or cleanup fails at startup for another reason is recorded and left for the next start; the app still starts (fixed; L6)."
    },
    {
      "id": "leases-startup-isolation-reverted",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "constants": {
        "StartupCleanupCanFail": "TRUE",
        "MaxRestarts": "2",
        "StartupIsolatesProviders": "FALSE"
      },
      "invariants": [
        "StartupSucceeds"
      ],
      "expect": {
        "violated": "StartupSucceeds"
      },
      "finding": "Without isolation, that failure rejects reconcileStartup and Relayer cannot start."
    },
    {
      "id": "leases-hang",
      "module": "ExecutionLeases",
      "preset": "leases-today",
      "constants": {
        "HarnessCanHang": "TRUE",
        "RustCanAbandon": "TRUE"
      },
      "fair": true,
      "properties": [
        "CancelledAccessEventuallyReleased"
      ],
      "expect": {
        "violated": "CancelledAccessEventuallyReleased"
      },
      "finding": "Open (per-turn force-stop PR): a cancelled native turn that ignores the cancellation keeps its provider access forever."
    },
    {
      "id": "catalog-refresh-keeps-chosen-default",
      "module": "CatalogRefresh",
