    },
    {
      "id": "catalog-stub-recovery-logout-deadlock",
      "module": "CatalogRefresh",
      "preset": "catalog-today",
      "constants": {
        "AllowPre": "FALSE",
        "AllowClose": "FALSE",
        "WithQ": "FALSE",
        "UserOps": "FALSE",
