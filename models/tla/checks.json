      "invariants": [
        "NoPersistingStaleEffect"
      ],
      "expect": {
        "violated": "NoPersistingStaleEffect"
      },
      "finding": "A refresh that discovered before a reconnect publishes its stale disconnected result after the reconnect, and nothing queued behind it corrects that."
