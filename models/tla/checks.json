        "InitDefFams": "{\"none\"}"
      },
      "invariants": [
        "TypeOK",
        "DefaultIsPaired",
        "RefreshKeepsUserDefault"
      ],
      "expect": "pass",
      "finding": "From an unset default family, a refresh may fill the family with its provider, but once the user chooses a provider and family no refresh changes them (PROV-008)."
    },
    {
      "id": "catalog-chosen-default-reverted",
      "module": "CatalogRefresh",
      "preset": "catalog-today",
      "constants": {
        "MaxEvents": "1",
