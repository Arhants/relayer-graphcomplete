{
  "version": 1,
  "tlaTools": {
    "version": "1.8.0",
    "url": "https://github.com/tlaplus/tlaplus/releases/download/v1.8.0/tla2tools.jar",
    "sha256": "7c6a30fcfca96c6d7476e705a545837afbf66446c3fcb34bf39b838cd50ee0c0"
  },
  "presets": {
    "providers": {
      "MaxTransientChecks": "3",
      "Execs": "{\"e1\"}",
      "RuntimeIds": "{1, 2, 3}"
    },
    "completion-today": {
      "Launchers": "{1, 2}",
      "MaxRev": "3",
      "ValidFailReasons": "{\"provider_exited_without_return\", \"application_restart\", \"execution\", \"provider_start_failed\", \"provider_attachment_persist_failed\", \"graph_observation_failed\", \"model_unavailable\"}",
      "ObserveTimesOut": "FALSE",
      "CleanExitIsChecked": "TRUE",
      "ActivationFailureSettlesGraph": "FALSE",
      "TerminalReadSettlesCleanup": "TRUE",
      "ChildAdmission": "TRUE"
    },
    "completion-fixed": {
      "Launchers": "{1, 2}",
      "MaxRev": "3",
      "ValidFailReasons": "{\"provider_exited_without_return\", \"application_restart\", \"execution\", \"provider_start_failed\", \"provider_attachment_persist_failed\", \"graph_observation_failed\", \"model_unavailable\"}",
      "ObserveTimesOut": "FALSE",
      "CleanExitIsChecked": "TRUE",
      "ActivationFailureSettlesGraph": "TRUE",
      "TerminalReadSettlesCleanup": "TRUE",
      "ChildAdmission": "TRUE"
    },
    "composer-today": {
      "Threads": "{\"A\", \"B\"}",
      "MaxTurns": "2",
      "MaxText": "2",
      "MaxRev": "5",
      "BackgroundRenders": "TRUE",
      "CarryUnsentDraft": "TRUE",
      "StableScopeRevision": "TRUE",
      "OtherTurns": "FALSE",
      "HoldFromClick": "TRUE",
      "HoldUncertain": "TRUE",
      "RetireSuperseded": "TRUE"
    },
    "composer-fixed": {
      "Threads": "{\"A\", \"B\"}",
      "MaxTurns": "2",
      "MaxText": "2",
      "MaxRev": "5",
      "BackgroundRenders": "TRUE",
      "CarryUnsentDraft": "TRUE",
      "StableScopeRevision": "TRUE",
      "OtherTurns": "TRUE",
      "HoldFromClick": "TRUE",
      "HoldUncertain": "TRUE",
      "RetireSuperseded": "TRUE"
    },
    "composer-replay": {
      "Threads": "{\"A\", \"B\"}",
      "MaxTurns": "2",
      "MaxText": "2",
      "MaxRev": "12",
      "BackgroundRenders": "TRUE",
      "CarryUnsentDraft": "TRUE",
      "StableScopeRevision": "TRUE",
      "OtherTurns": "TRUE",
      "HoldFromClick": "TRUE",
      "HoldUncertain": "TRUE",
      "RetireSuperseded": "TRUE"
    },
    "inspector-today": {
      "Nodes": "{\"n1\", \"n2\"}",
      "MaxRev": "3",
      "MaxEditors": "3",
      "Slots": "{1, 2, 3}",
      "QueueWhileResolving": "TRUE",
      "RefreshAfterResolve": "TRUE",
      "LatestRequestSupersedes": "TRUE"
    },
    "inspector-replay": {
      "Nodes": "{\"n1\", \"n2\"}",
      "MaxRev": "6",
      "MaxEditors": "6",
      "Slots": "{1, 2, 3, 4}",
      "QueueWhileResolving": "TRUE",
      "RefreshAfterResolve": "TRUE",
      "LatestRequestSupersedes": "TRUE"
    },
    "input": {
      "MaxVal": "2",
      "MaxRev": "5",
      "SendAwaitsAuthoredCommits": "TRUE",
      "KeepFailedCommit": "TRUE"
    },
    "canvas": {
      "L": "3",
      "MaxGen": "6",
      "KeepDragAcrossRender": "TRUE",
      "FitLayoutAfterDrop": "TRUE",
      "FitBeforeLeaving": "TRUE"
    },
    "catalog-today": {
      "MaxQ": "2",
      "MaxEvents": "2",
      "AllowPre": "TRUE",
      "AllowClose": "TRUE",
      "WithQ": "TRUE",
      "UserOps": "TRUE",
      "MaxFlips": "2",
      "InitAdapters": "{\"real\", \"stub\"}",
      "Ops": "{\"logout\", \"reconnect\", \"remove\"}",
      "InitDefFams": "{\"mP\", \"C\", \"none\"}",
      "DefaultProviderPairsFamily": "TRUE"
    }
  },
  "checks": [
    {
      "id": "provider-leased-runtime",
      "module": "ProviderSettings",
      "preset": "providers",
      "invariants": [
        "TypeOK",
        "LeasedRuntimeStaysOpen"
      ],
      "expect": {
        "violated": "LeasedRuntimeStaysOpen"
      },
      "finding": "A turn admitted while the provider looked connected leases the runtime a pending reconnect registered; cancelling that reconnect closes it under the turn."
    },
    {
      "id": "provider-remove-during-reconnect",
      "module": "ProviderSettings",
      "preset": "providers",
      "invariants": [
        "TypeOK",
        "PendingReconnectIsForActiveProvider"
      ],
      "expect": "pass",
      "finding": "Removing a provider drops its pending reconnect as it enters removal_pending (fixed; was: the reconnect outlived the removal)."
    },
    {
      "id": "provider-attempt-ownership",
      "module": "ProviderSettings",
      "preset": "providers",
      "invariants": [
        "TypeOK",
        "PendingAttemptIsOwned"
      ],
      "expect": "pass",
      "finding": "Every pending attempt keeps an owner, including when the renderer is destroyed before binding (fixed; BRW-005)."
    },
    {
      "id": "provider-close",
      "module": "ProviderSettings",
      "preset": "providers",
      "invariants": [
        "TypeOK",
        "CloseLeavesNoOpenRuntime"
      ],
      "expect": {
        "violated": "CloseLeavesNoOpenRuntime"
      },
      "finding": "close() does not drain the provider queue or refuse leases: a turn admitted before shutdown creates and registers a runtime after the maps are cleared."
    },
    {
      "id": "provider-default-family",
      "module": "ProviderSettings",
      "preset": "providers",
      "invariants": [
        "TypeOK",
        "DefaultFamilyIsLive"
      ],
      "expect": {
        "violated": "DefaultFamilyIsLive"
      },
      "finding": "Open product question: a catalog refresh reporting no eligible models tombstones the default family until a later refresh reactivates it. No PRD promise covers this."
    },
    {
      "id": "completion-safety-holds",
      "module": "CompletionCurrent",
      "preset": "completion-today",
      "invariants": [
        "TypeOK",
        "AtMostOneLaunch",
        "StopReportIsTruthful",
        "LeaseReleasedOnlyAfterSettlement",
        "ProviderRunsUnderLease",
        "AttemptEndsOnlyAfterProvider"
      ],
      "properties": [
        "TerminalIsAbsorbing"
      ],
      "expect": "pass",
      "finding": "One launch per reservation; stop reports what the graph holds; terminal states are absorbing; an admitted child ends its attempt and releases its leases only after it settles and its provider run ends."
    },
    {
      "id": "completion-observe-timeout",
      "module": "CompletionCurrent",
      "preset": "completion-today",
      "constants": {
        "ActivationFailureSettlesGraph": "TRUE",
        "CleanExitIsChecked": "TRUE",
        "TerminalReadSettlesCleanup": "TRUE"
      },
      "invariants": [
        "TypeOK",
        "NoExitFailureWhileRunning"
      ],
      "expect": "pass",
      "finding": "With observations that no longer time out, a child whose provider is still running is never failed for it (fixed; was: the 5 s control timeout failed running children). The re-poll itself is proved by provider_end_waits_through_observation_timeouts, not by this check."
    },
    {
      "id": "completion-activation-failure",
      "module": "CompletionCurrent",
      "preset": "completion-today",
      "constants": {
        "ObserveTimesOut": "FALSE",
        "CleanExitIsChecked": "TRUE",
        "TerminalReadSettlesCleanup": "TRUE"
      },
      "invariants": [
        "TypeOK",
        "SettledExecutionAgreesWithGraph"
      ],
      "expect": {
        "violated": "SettledExecutionAgreesWithGraph"
      },
      "finding": "A failed activation settles the execution row while the graph current stays active."
    },
    {
      "id": "completion-clean-exit",
      "module": "CompletionCurrent",
      "preset": "completion-today",
      "constants": {
        "Launchers": "{1}",
        "ObserveTimesOut": "FALSE",
        "ActivationFailureSettlesGraph": "TRUE",
        "TerminalReadSettlesCleanup": "TRUE"
      },
      "fair": true,
      "properties": [
        "LaunchedChildSettles"
      ],
      "expect": "pass",
      "finding": "A child whose provider exits cleanly without Return is failed and settles (fixed; was: it never settled, and with admission its attempt and leases were held forever)."
    },
    {
      "id": "completion-clean-exit-reverted",
      "module": "CompletionCurrent",
      "preset": "completion-today",
      "constants": {
        "Launchers": "{1}",
        "ObserveTimesOut": "FALSE",
        "ActivationFailureSettlesGraph": "TRUE",
        "TerminalReadSettlesCleanup": "TRUE",
        "CleanExitIsChecked": "FALSE"
      },
      "fair": true,
      "properties": [
        "LaunchedChildSettles"
      ],
      "expect": {
        "violated": "LaunchedChildSettles"
      },
      "finding": "Without the clean-exit check, a child whose provider exits cleanly without Return never settles."
    },
    {
      "id": "completion-start-failure-reason",
      "module": "CompletionCurrent",
      "preset": "completion-today",
      "constants": {
        "Launchers": "{1}",
        "ObserveTimesOut": "FALSE",
        "ActivationFailureSettlesGraph": "TRUE",
        "CleanExitIsChecked": "TRUE",
        "TerminalReadSettlesCleanup": "TRUE"
      },
      "fair": true,
      "properties": [
        "ClaimedChildSettles"
      ],
      "expect": "pass",
      "finding": "Start-failure cleanup fails the current with a reason the graph accepts (fixed; was: retried a rejected reason forever)."
    },
    {
      "id": "completion-start-failure-terminal",
      "module": "CompletionCurrent",
      "preset": "completion-today",
      "constants": {
        "Launchers": "{1}",
        "ObserveTimesOut": "FALSE",
        "ActivationFailureSettlesGraph": "TRUE",
        "CleanExitIsChecked": "TRUE"
      },
      "fair": true,
      "properties": [
        "ClaimedChildSettles"
      ],
      "expect": "pass",
      "finding": "Start-failure cleanup settles a current another actor already terminated, with that current's outcome (fixed; was: retried forever)."
    },
    {
      "id": "completion-child-admission-reverted",
      "module": "CompletionCurrent",
      "preset": "completion-today",
      "constants": {
        "ChildAdmission": "FALSE"
      },
      "invariants": [
        "TypeOK",
        "ProviderRunsUnderLease"
      ],
      "expect": {
        "violated": "ProviderRunsUnderLease"
      },
      "finding": "Without child admission, a selected child's provider runs with no held lease or attempt (the behavior before child admission)."
    },
    {
      "id": "completion-restart",
      "module": "CompletionCurrent",
      "preset": "completion-today",
      "invariants": [
        "TypeOK",
        "RestartNeverAborts"
      ],
      "expect": "pass",
      "finding": "Restart reconciliation does not abort on a state the product produced."
    },
    {
      "id": "completion-fixed-safety",
      "module": "CompletionCurrent",
      "preset": "completion-fixed",
      "invariants": [
        "TypeOK",
        "AtMostOneLaunch",
        "StopReportIsTruthful",
        "RestartNeverAborts",
        "NoExitFailureWhileRunning",
        "SettledExecutionAgreesWithGraph",
        "LeaseReleasedOnlyAfterSettlement",
        "ProviderRunsUnderLease",
        "AttemptEndsOnlyAfterProvider"
      ],
      "properties": [
        "TerminalIsAbsorbing"
      ],
      "expect": "pass",
      "finding": "The candidate fixes restore every safety invariant."
    },
    {
      "id": "completion-fixed-liveness",
      "module": "CompletionCurrent",
      "preset": "completion-fixed",
      "constants": {
        "Launchers": "{1}"
      },
      "fair": true,
      "properties": [
        "LaunchedChildSettles",
        "ClaimedChildSettles"
      ],
      "expect": "pass",
      "finding": "With the candidate fixes, every claimed child settles and releases its leases."
    },
    {
      "id": "catalog-refresh-keeps-chosen-default",
      "module": "CatalogRefresh",
      "preset": "catalog-today",
      "constants": {
        "MaxEvents": "1",
        "AllowPre": "FALSE",
        "AllowClose": "FALSE",
        "MaxFlips": "1",
        "InitAdapters": "{\"real\"}",
        "InitDefFams": "{\"mP\", \"C\"}"
      },
      "invariants": [
        "TypeOK",
        "DefaultIsPaired",
        "RefreshKeepsUserDefault",
        "RefreshKeepsOtherDefault"
      ],
      "expect": "pass",
      "finding": "Choosing a default provider also selects its managed family, so no later refresh changes the chosen provider or family (fixed, PROV-008; was: the next refresh of the family's provider moved the default provider back to it)."
    },
    {
      "id": "catalog-refresh-keeps-default-chosen-from-unset",
      "module": "CatalogRefresh",
      "preset": "catalog-today",
      "constants": {
        "MaxEvents": "1",
        "AllowPre": "FALSE",
        "AllowClose": "FALSE",
        "MaxFlips": "1",
        "InitAdapters": "{\"real\"}",
        "InitDefFams": "{\"none\"}"
      },
      "invariants": [
        "TypeOK",
        "DefaultIsPaired",
        "RefreshKeepsUserDefault"
      ],
      "expect": "pass",
      "finding": "From an unset default family, a refresh may fill the family with its provider, but once the user chooses a provider and family no refresh changes them (PROV-008)."
    },
    {
      "id": "catalog-chosen-default-reverted",
      "module": "CatalogRefresh",
      "preset": "catalog-today",
      "constants": {
        "MaxEvents": "1",
        "AllowPre": "FALSE",
        "AllowClose": "FALSE",
        "MaxFlips": "1",
        "InitAdapters": "{\"real\"}",
        "InitDefFams": "{\"mP\", \"C\"}",
        "DefaultProviderPairsFamily": "FALSE"
      },
      "invariants": [
        "RefreshKeepsUserDefault"
      ],
      "expect": {
        "violated": "RefreshKeepsUserDefault"
      },
      "finding": "Without the pairing, the Settings provider choice stores only the provider, and the next refresh of the default family's provider moves the default provider back to it."
    },
    {
      "id": "catalog-stale-refresh-after-reconnect",
      "module": "CatalogRefresh",
      "preset": "catalog-today",
      "constants": {
        "AllowPre": "FALSE",
        "AllowClose": "FALSE",
        "WithQ": "FALSE",
        "UserOps": "FALSE",
        "MaxFlips": "0",
        "InitAdapters": "{\"real\"}",
        "Ops": "{\"logout\", \"reconnect\"}",
        "InitDefFams": "{\"mP\"}"
      },
      "invariants": [
        "NoPersistingStaleEffect"
      ],
      "expect": {
        "violated": "NoPersistingStaleEffect"
      },
      "finding": "A refresh that discovered before a reconnect publishes its stale disconnected result after the reconnect, and nothing queued behind it corrects that."
    },
    {
      "id": "catalog-old-account-repopulates",
      "module": "CatalogRefresh",
      "preset": "catalog-today",
      "constants": {
        "AllowPre": "FALSE",
        "AllowClose": "FALSE",
        "WithQ": "FALSE",
        "UserOps": "FALSE",
        "MaxEvents": "1",
        "MaxFlips": "1",
        "InitAdapters": "{\"real\"}",
        "Ops": "{\"reconnect\"}"
      },
      "invariants": [
        "NoUnsafePopulate"
      ],
      "expect": {
        "violated": "NoUnsafePopulate"
      },
      "finding": "An eligible result discovered before a reconnect that found zero eligible models reactivates the tombstoned managed family."
    },
    {
      "id": "catalog-stale-adapter-capture",
      "module": "CatalogRefresh",
      "preset": "catalog-today",
      "constants": {
        "AllowPre": "FALSE",
        "AllowClose": "FALSE",
        "WithQ": "FALSE",
        "UserOps": "FALSE",
        "MaxEvents": "1",
        "MaxFlips": "0",
        "InitAdapters": "{\"stub\"}",
        "Ops": "{\"reconnect\"}",
        "InitDefFams": "{\"mP\"}"
      },
      "invariants": [
        "NoContradictingReplacedAdapterEffect"
      ],
      "expect": {
        "violated": "NoContradictingReplacedAdapterEffect"
      },
      "finding": "A refresh captures its adapter when requested; the unavailable stub it captured publishes after a reconnect replaced it and contradicts the reconnect."
    },
    {
      "id": "catalog-stub-recovery-logout-deadlock",
      "module": "CatalogRefresh",
      "preset": "catalog-today",
      "constants": {
        "AllowPre": "FALSE",
        "AllowClose": "FALSE",
        "WithQ": "FALSE",
        "UserOps": "FALSE",
        "MaxEvents": "1",
        "MaxFlips": "0",
        "InitAdapters": "{\"stub\"}",
        "Ops": "{\"logout\"}",
        "InitDefFams": "{\"mP\"}"
      },
      "fair": true,
      "properties": [
        "LogoutReturns"
      ],
      "expect": {
        "violated": "LogoutReturns"
      },
      "finding": "Logout waits inside the provider queue for its own refresh, which is queued behind an explicit stub recovery that waits for the provider queue: neither returns."
    },
    {
      "id": "catalog-no-restore-after-cancelled-reconnect",
      "module": "CatalogRefresh",
      "preset": "catalog-today",
      "constants": {
        "AllowPre": "FALSE",
        "AllowClose": "FALSE",
        "WithQ": "FALSE",
        "UserOps": "FALSE",
        "MaxEvents": "1",
        "MaxFlips": "2",
        "InitAdapters": "{\"stub\"}",
        "Ops": "{\"reconnect\"}",
        "InitDefFams": "{\"mP\"}"
      },
      "fair": true,
      "properties": [
        "DefaultRestoresAnyAdapter"
      ],
      "expect": {
        "violated": "DefaultRestoresAnyAdapter"
      },
      "finding": "A cancelled reconnect unregisters the catalog adapter of an active provider, so a tombstoned default family never restores."
    },
    {
      "id": "catalog-own-family",
      "module": "CatalogRefresh",
      "preset": "catalog-today",
      "constants": {
        "AllowPre": "FALSE",
        "AllowClose": "FALSE",
        "WithQ": "FALSE",
        "UserOps": "FALSE",
        "MaxFlips": "1"
      },
      "properties": [
        "OnlyOwnFamily"
      ],
      "expect": "pass",
      "finding": "A catalog publish changes only its own provider's managed family and never a custom family."
    },
    {
      "id": "catalog-tombstoned-default-blocks-send",
      "module": "CatalogRefresh",
      "preset": "catalog-today",
      "constants": {
        "AllowPre": "FALSE",
        "AllowClose": "FALSE",
        "WithQ": "FALSE",
        "UserOps": "FALSE",
        "MaxFlips": "1"
      },
      "invariants": [
        "TypeOK",
        "TombDefaultBlocksSend"
      ],
      "expect": "pass",
      "finding": "A default family tombstoned by a zero-eligible refresh stays the default and blocks Send."
    },
    {
      "id": "catalog-default-restores",
      "module": "CatalogRefresh",
      "preset": "catalog-today",
      "constants": {
        "AllowPre": "FALSE",
        "AllowClose": "FALSE",
        "WithQ": "FALSE",
        "UserOps": "FALSE",
        "MaxEvents": "1",
        "InitAdapters": "{\"real\"}",
        "Ops": "{\"logout\", \"reconnect\"}"
      },
      "fair": true,
      "properties": [
        "DefaultRestores"
      ],
      "expect": "pass",
      "finding": "A tombstoned default family restores once its provider is healthy and its real adapter is registered."
    },
    {
      "id": "composer-typing-during-send",
      "module": "TurnComposer",
      "preset": "composer-today",
      "invariants": [
        "TypeOK",
        "UnsentDraftSurvives"
      ],
      "expect": "pass",
      "finding": "Text typed while a follow-up is in flight survives the new turn loading (fixed; #512: it stayed in the old turn's draft scope, which was never shown again)."
    },
    {
      "id": "composer-typing-during-send-without-renders",
      "module": "TurnComposer",
      "preset": "composer-today",
      "constants": {
        "BackgroundRenders": "FALSE"
      },
      "invariants": [
        "TypeOK",
        "UnsentDraftSurvives"
      ],
      "expect": "pass",
      "finding": "The same holds when the prompt was re-enabled by leaving the thread and returning during the POST (fixed; #512)."
    },
    {
      "id": "composer-settlement-erases-edit",
      "module": "TurnComposer",
      "preset": "composer-today",
      "invariants": [
        "TypeOK",
        "SettlementClearsOnlySentText"
      ],
      "expect": "pass",
      "finding": "Settlement clears only text the send carried (fixed; #513: re-entering a scope could repeat a revision, so a successful send cleared and deleted text typed after Send)."
    },
    {
      "id": "composer-sent-text-lingers",
      "module": "TurnComposer",
      "preset": "composer-today",
      "invariants": [
        "TypeOK",
        "SentTextIsNotShownAgain"
      ],
      "expect": "pass",
      "finding": "A settled send does not leave its text in the composer (fixed; #513: re-entering a scope during a send bumped its revision without a text change, so settlement kept the sent text)."
    },
    {
      "id": "composer-one-send-per-thread",
      "module": "TurnComposer",
      "preset": "composer-today",
      "invariants": [
        "TypeOK",
        "OneSendPerThread"
      ],
      "properties": [
        "SendReleases"
      ],
      "fair": true,
      "expect": "pass",
      "finding": "At most one follow-up per thread is in flight, and every send releases its thread's Send button.",
      "constants": {
        "MaxRev": "4"
      }
    },
    {
      "id": "composer-fixed",
      "module": "TurnComposer",
      "preset": "composer-fixed",
      "invariants": [
        "TypeOK",
        "UnsentDraftSurvives",
        "SettlementClearsOnlySentText",
        "SentTextIsNotShownAgain",
        "OneSendPerThread",
        "SupersededStaysGone"
      ],
      "expect": "pass",
      "finding": "Moving unsent text to the newest turn's scope and keeping a scope's revision unless its text changes restore every composer promise."
    },
    {
      "id": "inspector-promises",
      "module": "NodeInspector",
      "preset": "inspector-today",
      "invariants": [
        "TypeOK",
        "LastRequestWins",
        "InspectorShowsSelection",
        "InspectorIsCurrent",
        "DraftedSelectionHasEditor",
        "OnlyLatestRequestSelects"
      ],
      "expect": "pass",
      "finding": "Input made while an annotation draft resolves waits and the latest proceeds (fixed; #514), the selection is re-rendered from the latest state once the draft resolves (fixed; #515), and a drafted node reopens its editor (PRD L2203)."
    },
    {
      "id": "inspector-without-supersede",
      "module": "NodeInspector",
      "preset": "inspector-today",
      "constants": {
        "LatestRequestSupersedes": "FALSE"
      },
      "invariants": [
        "TypeOK",
        "OnlyLatestRequestSelects"
      ],
      "expect": {
        "violated": "OnlyLatestRequestSelects"
      },
      "finding": "Without superseding it, a switch waiting on a draft save commits its node, reporting it and recording it in history, before a click queued meanwhile replaces it (review of #514)."
    },
    {
      "id": "input-send-carries-answer",
      "module": "AuthoredInputSend",
      "preset": "input",
      "invariants": [
        "TypeOK",
        "SendCarriesEnteredAnswer",
        "SendNotRefusedByOwnAnswer"
      ],
      "expect": "pass",
      "finding": "Send waits for an authored input commit started by the click, so it carries the answer and is not refused (fixed; #521: the Send could go without the answer, or be refused by it)."
    },
    {
      "id": "input-send-without-waiting",
      "module": "AuthoredInputSend",
      "preset": "input",
      "constants": {
        "SendAwaitsAuthoredCommits": "FALSE"
      },
      "invariants": [
        "TypeOK",
        "SendCarriesEnteredAnswer"
      ],
      "expect": {
        "violated": "SendCarriesEnteredAnswer"
      },
      "finding": "Without the wait, a Send served before the commit goes without the answer (#521)."
    },
    {
      "id": "input-send-forgets-early-failure",
      "module": "AuthoredInputSend",
      "preset": "input",
      "constants": {
        "KeepFailedCommit": "FALSE"
      },
      "invariants": [
        "TypeOK",
        "SendCarriesEnteredAnswer"
      ],
      "expect": {
        "violated": "SendCarriesEnteredAnswer"
      },
      "finding": "Without keeping a failed commit, one that fails before the click is forgotten, and the Send goes without the answer (review of #521)."
    },
    {
      "id": "composer-without-carry",
      "module": "TurnComposer",
      "preset": "composer-today",
      "constants": {
        "CarryUnsentDraft": "FALSE"
      },
      "invariants": [
        "TypeOK",
        "UnsentDraftSurvives"
      ],
      "expect": {
        "violated": "UnsentDraftSurvives"
      },
      "finding": "Without moving unsent text into the newest turn's scope, text typed during a send is stranded (#512)."
    },
    {
      "id": "composer-invoked-turns",
      "module": "TurnComposer",
      "preset": "composer-today",
      "constants": {
        "Threads": "{\"A\"}",
        "MaxTurns": "3",
        "OtherTurns": "TRUE"
      },
      "invariants": [
        "TypeOK",
        "UnsentDraftSurvives",
        "SettlementClearsOnlySentText",
        "SentTextIsNotShownAgain",
        "OneSendPerThread",
        "SupersededStaysGone"
      ],
      "expect": "pass",
      "finding": "With turns created elsewhere in the thread (an authored invoke) arriving while Send waits for an input commit, the composer keeps its promises (fixed in review of #512: the text was carried into the newer turn and stayed after it was sent)."
    },
    {
      "id": "composer-without-click-hold",
      "module": "TurnComposer",
      "preset": "composer-today",
      "constants": {
        "Threads": "{\"A\"}",
        "MaxTurns": "3",
        "HoldFromClick": "FALSE",
        "OtherTurns": "TRUE"
      },
      "invariants": [
        "TypeOK",
        "SentTextIsNotShownAgain"
      ],
      "expect": {
        "violated": "SentTextIsNotShownAgain"
      },
      "finding": "Without holding the submission from the click, a newer turn that arrives while Send waits for an input commit carries the text it then sends, and the text stays after the send (review of #512)."
    },
    {
      "id": "composer-without-uncertain-hold",
      "module": "TurnComposer",
      "preset": "composer-today",
      "constants": {
        "HoldUncertain": "FALSE"
      },
      "invariants": [
        "TypeOK",
        "SentTextIsNotShownAgain"
      ],
      "expect": {
        "violated": "SentTextIsNotShownAgain"
      },
      "finding": "Without holding a send that may have been sent, its text is carried into the turn it created and can be sent again (review of #512; SCP-019)."
    },
    {
      "id": "composer-without-retire",
      "module": "TurnComposer",
      "preset": "composer-today",
      "constants": {
        "RetireSuperseded": "FALSE",
        "OtherTurns": "TRUE"
      },
      "invariants": [
        "TypeOK",
        "SupersededStaysGone"
      ],
      "expect": {
        "violated": "SupersededStaysGone"
      },
      "finding": "Without retiring it, stranded text the user replaced by typing stays in its scope and is carried forward once the prompt empties (review of #512, SCP-021)."
    },
    {
      "id": "inspector-without-queue",
      "module": "NodeInspector",
      "preset": "inspector-today",
      "constants": {
        "QueueWhileResolving": "FALSE"
      },
      "invariants": [
        "TypeOK",
        "LastRequestWins"
      ],
      "expect": {
        "violated": "LastRequestWins"
      },
      "finding": "Without waiting, input made while a draft resolves is dropped (#514)."
    },
    {
      "id": "inspector-without-refresh",
      "module": "NodeInspector",
      "preset": "inspector-today",
      "constants": {
        "RefreshAfterResolve": "FALSE"
      },
      "invariants": [
        "TypeOK",
        "InspectorShowsSelection"
      ],
      "expect": {
        "violated": "InspectorShowsSelection"
      },
      "finding": "Without the refresh, a refused switch can leave the kept node's detail disposed (#515)."
    },
    {
      "id": "canvas-promises",
      "module": "CanvasGesture",
      "preset": "canvas",
      "invariants": [
        "TypeOK",
        "DragFollowsPointer",
        "DropStays",
        "DropFitsNewLayout"
      ],
      "expect": "pass",
      "finding": "A dragged node follows the pointer and stays where it is left across renders and view round trips, and only a pan or a new layout moves the camera (fixed; #531: a render during a drag froze the node).",
      "properties": [
        "CameraMovesOnlyByPanOrFit"
      ]
    },
    {
      "id": "canvas-without-rebind",
      "module": "CanvasGesture",
      "preset": "canvas",
      "constants": {
        "KeepDragAcrossRender": "FALSE"
      },
      "invariants": [
        "TypeOK",
        "DragFollowsPointer"
      ],
      "expect": {
        "violated": "DragFollowsPointer"
      },
      "finding": "Without re-binding, a render during a drag leaves the drag on the replaced node, which stops following the pointer (#531)."
    },
    {
      "id": "canvas-without-fit-after-drop",
      "module": "CanvasGesture",
      "preset": "canvas",
      "constants": {
        "FitLayoutAfterDrop": "FALSE"
      },
      "invariants": [
        "TypeOK",
        "DropFitsNewLayout"
      ],
      "expect": {
        "violated": "DropFitsNewLayout"
      },
      "finding": "Without the fit after the drop, a layout that changed mid-drag is never fitted, and new nodes can stay off-screen (review of #531)."
    },
    {
      "id": "canvas-without-fit-before-leaving",
      "module": "CanvasGesture",
      "preset": "canvas",
      "constants": {
        "FitBeforeLeaving": "FALSE"
      },
      "invariants": [
        "TypeOK",
        "DropFitsNewLayout"
      ],
      "expect": {
        "violated": "DropFitsNewLayout"
      },
      "finding": "Without fitting before the view is cached, leaving mid-drag after a layout change caches the unfitted camera, and returning restores it (review of #531)."
    }
  ]
